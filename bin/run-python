#!/usr/bin/env bash
# Launch memgraph.cli with the first usable Python >= 3.10 (skips the Windows Store python3 stub).
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
for c in python3 python py; do
  if "$c" -c 'import sys; sys.exit(sys.version_info < (3, 10))' >/dev/null 2>&1; then
    PYTHONPATH="$ROOT" exec "$c" -m memgraph.cli "$@"
  fi
done
exit 0
