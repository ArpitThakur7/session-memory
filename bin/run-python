#!/usr/bin/env bash
# Launch memgraph.cli with one Python start: run the first python3/python/py on PATH directly
# (memgraph.cli exits quietly on Python older than 3.10). The Windows Store python3 stub is skipped
# without starting it; if exec of a candidate fails, the next one is tried.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$ROOT"
shopt -s execfail
for c in python3 python py; do
  p="$(command -v "$c" 2>/dev/null)" || continue
  case "$p" in *WindowsApps*) continue ;; esac
  exec "$p" -m memgraph.cli "$@"
done
exit 0
